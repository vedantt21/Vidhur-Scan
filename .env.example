# Optional: enables OpenAI-assisted photo parsing and text cleanup.
# The app still runs without these values and will fall back to browser OCR.

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini

# Optional: public origin used when building verification links.
APP_ORIGIN=http://127.0.0.1:3000

# Optional: SMTP settings for real verification email delivery.
# If SMTP_HOST is omitted, the app will fall back to a clickable verification preview link instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Ingredient Screen <no-reply@example.com>
